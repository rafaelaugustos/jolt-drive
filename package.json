{
  "name": "jolt-drive",
  "main": "src/app.ts",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@nativescript/core": "9.1.3",
    "@rafaelaugusto/jolt": "0.1.0-rc.10",
    "@rafaelaugusto/jolt-native": "0.1.0-rc.10",
    "nativescript-vue": "3.1.2",
    "vue-router-ns": "0.1.0-rc.4"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/ios": "9.1.0",
    "@nativescript/types": "~9.1.1",
    "@nativescript/webpack": "~5.0.38",
    "@types/node": "~26.5.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "scripts": {
    "assets": "scripts/render-assets.sh",
    "test:camera": "node --test tests/camera-path.test.cjs",
    "test:scene": "node --test tests/camera-path.test.cjs tests/emission-color.test.cjs tests/austin-route.test.cjs",
    "typecheck": "vue-tsc --noEmit",
    "ios": "ns run ios",
    "build:ios": "ns build ios --no-hmr",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "assets:icon": "scripts/render-ios-icon.sh"
  },
  "description": "An iOS driving experience built with NativeScript, Vue, and Jolt."
}
